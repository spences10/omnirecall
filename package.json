{
	"name": "omnirecall-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter omnirecall build",
		"dev": "pnpm --filter omnirecall dev",
		"start": "pnpm --filter omnirecall start",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp fmt",
		"test": "pnpm build && vp test",
		"test:watch": "pnpm build && vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm check && pnpm test && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.3.4"
}
