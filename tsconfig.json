{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node", "vitest"]
	},
	"include": ["apps/cli/src", "packages/*/src"],
	"exclude": ["node_modules", "**/dist"]
}
